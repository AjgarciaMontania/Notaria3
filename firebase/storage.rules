rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de Storage — Notaría Única de Cartagena del Chairá
//
// Los documentos solo se pueden listar, ver, subir, reemplazar o borrar si la
// cuenta tiene nivel "admin" o "personal". El nivel se consulta en Firestore,
// en la colección "usuarios", que se administra desde el panel de la página
// web. Una cuenta sin ficha no puede tocar ningún archivo.
//
// Dónde se pegan: console.firebase.google.com → tu proyecto →
// Storage → pestaña "Reglas" → pegar → Publicar.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function haIniciadoSesion() {
      return request.auth != null && request.auth.token.email != null;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    // Llave maestra: mismo correo que en firestore.rules y src/utils/roles.js.
    function esAdminRaiz() {
      return haIniciadoSesion() && correo() == 'cha1@outlook.es';
    }

    function tieneFicha() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(correo()));
    }

    function rolDeLaFicha() {
      return firestore.get(/databases/(default)/documents/usuarios/$(correo())).data.rol;
    }

    // Puede trabajar con los documentos. Sin ficha → no puede.
    function puedeOperar() {
      return esAdminRaiz()
        || (haIniciadoSesion()
            && tieneFicha()
            && (rolDeLaFicha() == 'admin' || rolDeLaFicha() == 'personal'));
    }

    // Permiso para RECORRER las carpetas de evidencias.
    //
    // Firebase autoriza el listado de una ruta con la regla que cubre lo que
    // está UN NIVEL MÁS ABAJO. Para "recibos-registro" y "soportes-escrituras"
    // eso es {archivo}, y sus reglas ya lo cubrían. Pero en "evidencias" lo que
    // hay un nivel más abajo son carpetas, y no existía ninguna regla para
    // ellas: por eso listar "evidencias" daba storage/unauthorized.
    //
    // La página web nunca lo notó porque no le pregunta a Storage qué
    // documentos hay: se guía por la colección "files" de Firestore. Salió a la
    // luz con el respaldo, que sí tiene que recorrer el bucket de verdad.
    //
    // Se concede "list" y no "read": deja recorrer las carpetas, sin abrir
    // ningún documento. Los documentos se leen con la regla de abajo.
    match /evidencias/{carpeta} {
      allow list: if puedeOperar();
    }

    match /evidencias/{carpeta}/{archivo} {

      allow read: if puedeOperar();

      // En subir y reemplazar se comprueba además el tamaño.
      // 50 MB es holgado para un PDF escaneado y evita que un error
      // (o alguien con malas intenciones) llene el bucket.
      allow create, update: if puedeOperar()
                            && request.resource.size < 50 * 1024 * 1024;

      // El borrado va aparte: al borrar no existe request.resource, así que
      // no se le puede pedir el tamaño.
      allow delete: if puedeOperar();
    }

    // Soportes de envío de escrituras a la notaría de Florencia.
    // Un mismo archivo puede amparar varias escrituras, por eso van todos
    // juntos en esta carpeta y no anidados por número de escritura.
    match /soportes-escrituras/{archivo} {

      allow read: if puedeOperar();

      allow create, update: if puedeOperar()
                            && request.resource.size < 50 * 1024 * 1024;

      allow delete: if puedeOperar();
    }

    // Recibos de pago de impuestos: uno por escritura. Es la etapa anterior al
    // envío, cuando el documento ya está radicado en la ORIP.
    match /recibos-registro/{archivo} {

      allow read: if puedeOperar();

      allow create, update: if puedeOperar()
                            && request.resource.size < 50 * 1024 * 1024;

      allow delete: if puedeOperar();
    }

    // Cualquier otra ruta del bucket, cerrada.
    match /{ruta=**} {
      allow read, write: if false;
    }
  }
}
